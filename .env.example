# Copy to .env.local. These are the Supabase CLI's fixed values for a local stack — the same for
# every contributor, not secrets. `supabase status -o env` prints them for a running stack.

# Browser-safe. Read by the browser, server and proxy client factories.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH"

# Server-only, deliberately without the NEXT_PUBLIC_ prefix so it cannot reach the browser bundle.
# Used exclusively by the test suite, to mint verification and recovery links through the admin API.
# Nothing under app/, components/ or lib/ may import it — tests/unit/secret-key-containment.test.ts
# enforces that.
SUPABASE_SECRET_KEY="sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz"
